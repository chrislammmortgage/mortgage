# =============================================================================
# Theme Day Call Automation — environment template
# Copy to .env and fill in. NEVER commit .env. See automation/README.md.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
TZ=America/Los_Angeles
PORT=3001
LOG_LEVEL=info
# Set to "true" to skip all outbound writes (no SF tasks, no PB dial sets,
# no emails). Use this on every first run.
DRY_RUN=true

# ---- Owner / branch ----
OWNER_EMAIL=chris@chrislamm.example
OWNER_NAME=Chris Lamm
ASSIGNEE_EMAILS=zak@chrislamm.example,jennifer@chrislamm.example,toni@chrislamm.example

# ---- Salesforce (Jungo) ----
# Connected App: refresh-token flow recommended
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
SF_INSTANCE_URL=
# Field API names — override if your org uses different ones
SF_FIELD_LAST_TOUCH=Last_Touch__c
SF_FIELD_THEMEDAY_TOUCH=Last_Theme_Day_Touch__c
SF_FIELD_ACTIVE_REALTOR=Active_Realtor__c
SF_FIELD_LO_ASSIGNED=Loan_Officer__c
SF_FIELD_PAS_ASSIGNED=PAS_Assigned__c
SF_FIELD_REALTOR_VOLUME_12MO=Realtor_Volume_12mo__c
SF_FIELD_CAPTURE_RATE=Capture_Rate__c
SF_FIELD_ROTATION_POOL=Rotation_Pool__c

# ---- PhoneBurner ----
PHONEBURNER_CLIENT_ID=
PHONEBURNER_CLIENT_SECRET=
PHONEBURNER_REFRESH_TOKEN=
PHONEBURNER_MEMBER_ID=
PHONEBURNER_BASE_URL=https://www.phoneburner.com/rest/1/
# Folder IDs you want each Theme Day dial set placed into (optional)
PB_FOLDER_MONDAY=
PB_FOLDER_TUESDAY=
PB_FOLDER_WEDNESDAY=
PB_FOLDER_THURSDAY=
PB_FOLDER_FRIDAY=
# Public URL the PhoneBurner disposition webhook should POST to
PB_WEBHOOK_URL=https://your.tunnel.example/webhooks/phoneburner

# ---- Email (Microsoft 365 / Outlook) ----
# We send via Microsoft Graph; either device-code or client-credentials app.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_FROM_ADDRESS=chris@chrislamm.example

# ---- Enrichment ----
FIRECRAWL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
NEVERBOUNCE_API_KEY=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# ---- Approval webhook secret (signs draft-approval links) ----
APPROVAL_SECRET=change-me-to-a-long-random-string
